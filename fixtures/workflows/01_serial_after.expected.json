{
  "workflow": {
    "fail_fast": true,
    "max_parallelism": 4,
    "nodes": [
      {
        "deps": [],
        "id": "diff",
        "tool": "git",
        "tool_args": {
          "action": "diff",
          "mode": "all"
        }
      },
      {
        "deps": [
          "diff"
        ],
        "id": "clippy",
        "tool": "cargo_clippy",
        "tool_args": {
          "all_targets": true
        }
      },
      {
        "deps": [
          "clippy"
        ],
        "id": "test",
        "tool": "cargo_test",
        "tool_args": {}
      }
    ]
  }
}
