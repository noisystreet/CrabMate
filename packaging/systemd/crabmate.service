[Unit]
Description=CrabMate HTTP API (serve)
Documentation=man:crabmate(1)
After=network-online.target
Wants=network-online.target
# Avoid restart storms (e.g. port already in use)
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=crabmate
Group=crabmate
WorkingDirectory=/var/lib/crabmate
# Optional: copy crabmate.env.example → /etc/crabmate/crabmate.env and chmod 600
# EnvironmentFile lines must be KEY=value (no `export`, no shell syntax).
EnvironmentFile=-/etc/crabmate/crabmate.env
Environment=RUST_LOG=info
# Minimal PATH for system user; extend in crabmate.env for cargo/rustc (e.g. /usr/local/cargo/bin).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# --config anchors relative system_prompt_file paths under /etc/crabmate/
# Default: loopback :8080, API-only (no SPA).
# To host Client UI on the same process: add --with-web and set CM_WEB_STATIC_DIR.
# Without --with-web, / is 404 while /health and APIs still work.
ExecStart=/usr/bin/crabmate --config /etc/crabmate/config.toml serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
