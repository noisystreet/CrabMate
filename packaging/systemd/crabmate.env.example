# Copy to /etc/crabmate/crabmate.env and chmod 600 before enabling the unit.
# Do not commit real secrets. Placeholders only.
#
# IMPORTANT: systemd EnvironmentFile format is KEY=value only.
# Do NOT use `export`, shebang, or other shell syntax (that breaks the service).

# LLM Bearer (when llm_http_auth_mode = bearer). Prefer keyring / sidebar when possible.
# API_KEY=YOUR_LLM_API_KEY

# Require Web API Bearer on protected routes (recommended behind a reverse proxy).
# CM_WEB_API_REQUIRE_BEARER=1
# CM_WEB_API_BEARER_TOKEN=YOUR_LONG_RANDOM_SECRET

# Workspace roots (adjust to your host layout).
# CM_WEB_WORKSPACE_POOL=/var/lib/crabmate/workspace
# CM_WORKSPACE_ALLOWED_ROOTS=/var/lib/crabmate/workspace

# Optional static UI from Client build. Packaged unit does NOT pass --no-web, so this works:
#   cd ../crabmate-client && make frontend
# CM_WEB_STATIC_DIR=/path/to/crabmate-client/frontend/dist
#
# Pure API-only: leave unset (root / stays 404) or add --no-web via systemctl edit.

# System user has a minimal PATH; add toolchain dirs if tools need cargo/rustc:
# PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUST_LOG=info
