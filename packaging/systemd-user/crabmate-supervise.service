# CrabMate 本地多实例守护 —— **用户级** unit 示例（无 root / 容器内 / 临时机器）。
#
# 与同目录的 `crabmate.service`（system 级，需 root）是两条互不替代的路径：
# 那条跑单个 `serve`，这条跑 `crabmatectl supervise` 管理**多个**实例。
#
# 安装：
#   mkdir -p ~/.config/systemd/user
#   cp crabmate-supervise.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now crabmate-supervise.service
#   # 未登录也要常驻（可选，需一次 sudo）：
#   loginctl enable-linger "$USER"
#
# 前置条件（ctl 会主动拒绝不满足的声明，不是建议而是硬要求）：
#   1. `instances.toml` 必须是 `0600` —— 它等同「一份进程启动清单」，宽权限会被
#      `instances_file_insecure` 拒绝，`--watch` 下则暂停收敛并告警：
#        install -m 600 /dev/null ~/.config/crabmate/instances.toml
#      引用了 profile 时 `profiles.toml` 同样要 `0600`（`profiles_file_insecure`）。
#   2. `ExecStart` 必须是**绝对路径**（systemd 不查 PATH）。下面按 `~/.local/bin`
#      写；若 crabmatectl 装在 `/usr/bin`（deb 包即如此），改成 `/usr/bin/crabmatectl`。
#
# 为什么是 `--watch --restart on-failure --socket`：
#   `supervise` 不带 `--watch` 时只做一次收敛就退出（那条形态适合让 systemd 自己
#   按 Restart= 拉起）；要让「声明被改」与「实例自己崩了」都由 ctl 负责，才需要
#   这两个开关。`--restart` 默认是 `never`，不写就不会有重启行为。
#
#   为什么还要 `--socket`：这是客户端管理 lane 的**唯一**通道。TUI / Desktop 被禁止
#   spawn `crabmatectl`，也不该自己写 `instances.toml`（会与 `--watch` 构成两个写入者），
#   于是它们的 `/ctl` 列表与 `/lane new|close|open` 全部经这条 unix socket；不给它，
#   客户端只剩「连已经存在的实例」，加 / 停 lane 必须回到终端敲 ctl。socket 不监听 TCP、
#   目录 `0700` / socket `0600`，仅有文件权限这一道鉴权，故不扩大攻击面（同用户进程本来
#   就能直接写 `instances.toml`）。
#
#   路径显式写成 `%t/crabmate/ctl.sock`：`%t` 在 user 单元里就是 `$XDG_RUNTIME_DIR`，
#   与客户端派生默认路径的算法一致。不写值时 ctl 在 `XDG_RUNTIME_DIR` 缺失的情况下会
#   回退到状态目录，而客户端**不猜**（拿不到该变量就判定「控制面未启用」）—— 显式给出
#   才不会出现「ctl 在服务、客户端找不到」。

[Unit]
Description=CrabMate local multi-instance serve supervisor (crabmatectl)
Documentation=man:crabmatectl(1)
After=network.target

[Service]
Type=simple
# ctl 自己会建 `0700` 目录并 chmod socket（`paths::prepare_control_socket`），
# 但对 `$XDG_RUNTIME_DIR` 下的目录交给 systemd 更干净：`systemctl --user stop` 之后
# socket 与目录一起消失，残留只在 ctl 被 SIGKILL 时出现，那种情况由 `clear_stale()` 兜住。
RuntimeDirectory=crabmate
RuntimeDirectoryMode=0700
ExecStart=%h/.local/bin/crabmatectl supervise --from-config --watch --restart on-failure --socket %t/crabmate/ctl.sock
# ctl 常驻失败时由 systemd 兜底；ctl 是**唯一**的写者，重启它会重新读声明收敛。
Restart=on-failure
RestartSec=5
# 子实例的环境由 ctl 用 env_clear + 白名单构造（只带 PATH/HOME/XDG_* 与声明里的
# env 表），所以这里**不需要**传 API_KEY —— 也不要传：那会让「隔离实例」变成空话，
# 且声明里出现敏感变量名会被 ctl 直接拒绝。
#
# ctl 用 setsid 让子实例脱管，所以 ctl 自身退出后实例仍在跑；但 `systemctl --user
# stop` 停的是整个 cgroup，仍会一并收掉（这正是停止时想要的行为）。

[Install]
WantedBy=default.target
