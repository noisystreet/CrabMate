########################
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
*.tmp
*.bak
*.orig

########################
# Node / 前端
########################
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.trunk/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.turbo/
# 仅忽略仓库根与桌面同步产物；mobile-tauri/dist 为连接页源码须提交
/dist/
desktop-tauri/dist/
build/
coverage/

########################
# Python
########################
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

########################
# IDE / 工具
########################
.idea/
.vscode/
.history/
.env
.env.*

########################
# Cursor（仅纳入 `.cursor/rules/`，其余本地产物不提交）
########################
.cursor/*
!.cursor/rules/
!.cursor/rules/**

########################
# Rust
########################
/target/
# Tauri 子工程构建产物
desktop-tauri/src-tauri/target/
mobile-tauri/src-tauri/target/
# make apk 稳定产物名（Gradle 原始 APK 在 gen/android/…）
mobile-tauri/crabmate.apk
# Tauri 构建生成的 ACL Schema（从源码自动生成，无需提交）
desktop-tauri/src-tauri/gen/
# Android 工程 gen/android 需提交；仅忽略 ACL schema 生成物时用下方规则（与 desktop 对齐可整目录忽略后手工保留 android）
mobile-tauri/src-tauri/gen/schemas/
# Tauri sidecar：由 `desktop-tauri/scripts/prepare-sidecar.sh` 从仓库根 `target/` 复制
desktop-tauri/binaries/
# 若使用 cargo vendor 或 path 依赖到 vendor/，忽略其 target
vendor/**/target/

########################
# 本机 CrabMate 数据（工作区下 .crabmate，勿提交）
########################
.crabmate/

########################
# 本机缓存（勿提交；正式路径为 $XDG_CACHE_HOME/crabmate/）
########################
# 历史 cwd 缓存目录名（已不再写入；保留忽略以防误提交）
.fastembed_cache/

########################
# Agent 临时文档（本机产物，勿提交）
########################
agent_space/

########################
# 杂项
########################
tmp/
*.iml
*.out
*.class
*.tgz
*.tar.gz
*.zip
chat_export_*.md
# SSE / Turn replay（本机调试产物，勿提交）
turn-replay-events.jsonl
sse-replay-events.jsonl
# proptest 回归测试缓存（本机产物，勿提交）
proptest-regressions/
.playwright-mcp/

# Standalone connect package; lock owned by desktop/mobile workspaces.
/crates/crabmate-connect/Cargo.lock
